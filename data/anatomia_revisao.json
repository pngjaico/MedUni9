          "title": "Músculos da Respiração",
          "regiao": "torax",
          "blocks": [
            {
              "type": "cards",
              "items": [
                {
                  "q": "Diafragma",
                  "a": "Principal músculo da inspiração. Inervado pelo N. frênico (C3–C5). \"C3, C4, C5 keeps the diaphragm alive\""
                },
                {
                  "q": "Músculos acessórios",
                  "a": "Inspiração forçada: escalenos, ECM, peitorais · Expiração ativa: reto abdominal, oblíquos abdominais"
                }
              ]
            }
          ]
        }
      ]
    },
