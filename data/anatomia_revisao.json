    {
      "id": "muscular",
      "name": "Sistema Muscular",
      "icone": "muscular",
      "color": "#EA580C",
      "subsections": [
        {
          "title": "Conceitos e organização",
          "regiao": null,
          "blocks": [
            {
              "type": "sequence",
              "title": "Do músculo ao movimento (visão geral)",
              "steps": [
                {
                  "label": "Fibras musculares",
                  "detail": "estriadas esqueléticas, multinucleadas, dispostas em feixes"
                },
                {
                  "label": "Perimísio e endomísio",
                  "detail": "envoltórios conjuntivos; tendão ancora no osso"
                },
                {
                  "label": "Inserção origem → inserção",
                  "detail": "a parte móvel costuma ser a inserção"
                },
                {
                  "label": "Sinergistas e antagonistas",
                  "detail": "mesma articulação: um flexiona, outro estende"
                }
              ]
            },
            {
              "type": "cards",
              "items": [
                {
                  "q": "Tipos de músculo (macro)",
                  "a": "Esquelético (estriado, voluntário) · Cardíaco (estriado, involuntário) · Liso (não estriado, vísceras e vasos). A revisão macro foca o esquelético."
                },
                {
                  "q": "Termos de ação",
                  "a": "Flexão / extensão · Abdução / adução · Rotação medial ou lateral · Pronação / supinação (antebraço) · Dorsiflexão / flexão plantar (tornozelo)"
                },
                {
                  "q": "Inervação motora",
                  "a": "Cada músculo recebe ramos de um ou mais nervos espinais ou cranianos; lesão do nervo → fraqueza + eventual alteração sensitiva no dermátomo."
                }
              ]
            }
          ]
        },
        {
          "title": "Face, mastigação e expressão",
          "regiao": "cabeca_pescoco",
          "blocks": [
            {
              "type": "hub",
              "title": "Músculos da mastigação (V3)",
              "center": "Articulação têmporo-mandibular",
              "branches": [
                {
                  "label": "Masseter",
                  "hint": "eleva mandíbula"
                },
                {
                  "label": "Temporal",
                  "hint": "eleva e retrai"
                },
                {
                  "label": "Pterigóideo medial",
                  "hint": "eleva; movimento lateral"
                },
                {
                  "label": "Pterigóideo lateral",
                  "hint": "abre a boca; protrai mandíbula"
                }
              ]
            },
            {
              "type": "cards",
              "items": [
                {
                  "q": "Mímica (ramo facial VII)",
                  "a": "Occipitofrontal · Orbicular dos olhos · Orbicular da boca · Bucinador (bochecha) · Platisma (pele fina do pescoço). Paralisia facial periférica: face ipsilateral «cai»."
                },
                {
                  "q": "Supra-hióideos (elevar laringe / hióide)",
                  "a": "Digástrico (VII + V3) · Estilo-hióideo (XII) · Milo-hióideo (V3) — abrem a boca e preparam a deglutição."
                },
                {
                  "q": "Infra-hióideos (baixar hióide)",
                  "a": "Esterno-hióideo · Omohióideo · Tireo-hióideo · Escaleno-hióideo — estabilizam o hióide na fala e deglutição."
                }
              ]
            }
          ]
        },
        {
          "title": "Pescoço — flexores e extensores",
          "regiao": "cabeca_pescoco",
          "blocks": [
            {
              "type": "sequence",
              "title": "Camadas (superficial → profundo, simplificado)",
              "steps": [
                {
                  "label": "Trapezéio (parte superior)",
                  "detail": "eleva escápula; extensão do pescoço com bilateralidade"
                },
                {
                  "label": "Esternocleidomastóideo (ECM)",
                  "detail": "flexão ipsilateral rotação contralateral (uma cabeça); bilateral flexão do pescoço"
                },
                {
                  "label": "Escalenos (ant., médio, post.)",
                  "detail": "elevam 1.ª costela (inspiração); bordo anterior do scalene = pulso da artéria subclávia"
                },
                {
                  "label": "Pré-vertebrais (longo do pescoço, reto anterior…)",
                  "detail": "flexão da coluna cervical"
                }
              ]
            },
            {
              "type": "cards",
              "items": [
                {
                  "q": "Triângulos do pescoço",
                  "a": "Anterior: carótidas, tireoide, paratireoides. Posterior: estruturas mais profundas. Nervo frênico (C3–C5) passa sobre o m. escaleno anterior (triângulo costoclavicular)."
                },
                {
                  "q": "Inervação motora principal",
                  "a": "Plexo cervical (C1–C4): pré-vertebrais, infra-hióideos, diafragma (frênico). Trapezéio e ECM: acessório (XI) + plexo cervical."
                }
              ]
            }
          ]
        },
        {
          "title": "Tórax — parede e respiração",
          "regiao": "torax",
          "blocks": [
            {
              "type": "hub",
              "title": "Músculos da respiração",
              "center": "Diafragma (principal)",
              "branches": [
                {
                  "label": "Intercostais externos",
                  "hint": "inspiração (elevam costelas)"
                },
                {
                  "label": "Intercostais internos",
                  "hint": "expiração forçada"
                },
                {
                  "label": "Escalenos",
                  "hint": "elevam 1.ª costela — inspiração acessória"
                },
                {
                  "label": "Peitorais (parte abdominal)",
                  "hint": "expiração forçada"
                }
              ]
            },
            {
              "type": "cards",
              "items": [
                {
                  "q": "Diafragma",
                  "a": "Fixa-se na margem costal, processos lombares e tendão central. Inervação: nervo frênico (C3–C5). Paralisia → elevação paradoxal da cúpula."
                },
                {
                  "q": "Peitoral maior",
                  "a": "Adoção e rotação medial do úmero; parte clavicular flexiona o braço; parte esternocostal potente em adução. N. pectoral medial e lateral (plexo braquial)."
                },
                {
                  "q": "Serrátil anterior",
                  "a": "Estabiliza escápula contra a parede torácica; lesão do nervo torácico longo → «escápula alada»."
                }
              ]
            }
          ]
        },
        {
          "title": "Abdome — parede e compressão",
          "regiao": "abdome",
          "blocks": [
            {
              "type": "sequence",
              "title": "Camadas da parede (lateral)",
              "steps": [
                {
                  "label": "Oblíquo externo",
                  "detail": "fibras inferomediais"
                },
                {
                  "label": "Oblíquo interno",
                  "detail": "fibra perpendicular ao externo"
                },
                {
                  "label": "Transverso do abdome",
                  "detail": "fibras horizontais — «cinto»"
                },
                {
                  "label": "Reto abdominal",
                  "detail": "envolto na bainha — flexão do tronco"
                }
              ]
            },
            {
              "type": "cards",
              "items": [
                {
                  "q": "Triângulo de Hesselbach (ponto fraco)",
                  "a": "Borda lateral do reto, vasos epigástricos inferiores e ligamento inguinal — local típico de hérnia inguinal direta."
                },
                {
                  "q": "Quadrilátero de Lumbar",
                  "a": "Limitado pelo reto, oblíquo interno, transverso e quadrado lombar — passagem dos nervos ilio-hipogástrico e ilioinguinal."
                },
                {
                  "q": "Psoas maior e ilíaco",
                  "a": "Flexores potentes do quadril; psoas emerge da cavidade sob o ligamento inguinal. Sinérgicos na marcha em declive."
                }
              ]
            }
          ]
        },
        {
          "title": "Dorso — eretores e escápula",
          "regiao": "cabeca_tronco",
          "blocks": [
            {
              "type": "cards",
              "items": [
                {
                  "q": "Espinhais (eretores da coluna)",
                  "a": "Iliocostal · Longuíssimo · Espinal — estendem a coluna e controlam postura; trabalham em sinergia com abdome e diafragma."
                },
                {
                  "q": "Romboides e elevador da escápula",
                  "a": "Retraem e elevam a escápula; importante em remada e postura. N. dorsal da escápula (C5) e acessório (XI) conforme o músculo."
                },
                {
                  "q": "Grande dorsal",
                  "a": "Extensão, adução e rotação medial do braço; «nadador». Origem larga em dorso; insere na crista do tubérculo menor do úmero."
                },
                {
                  "q": "Trapézio (partes média e inferior)",
                  "a": "Retração e rotação inferior da escápula (parte inferior); estabilização dinâmica do ombro."
                }
              ]
            }
          ]
        },
        {
          "title": "Membro superior — ombro e braço",
          "regiao": "membro_superior",
          "blocks": [
            {
              "type": "hub",
              "title": "Manguito rotador (SIPS)",
              "center": "Cavidade glenóide",
              "branches": [
                {
                  "label": "Supraespinhoso",
                  "hint": "inicia abdução"
                },
                {
                  "label": "Infraespinhoso",
                  "hint": "rotação lateral"
                },
                {
                  "label": "Pequeno redondo",
                  "hint": "rotação lateral"
                },
                {
                  "label": "Subescapular",
                  "hint": "rotação medial"
                }
              ]
            },
            {
              "type": "cards",
              "items": [
                {
                  "q": "Deltoide",
                  "a": "Abdução do ombro (principal a partir de ~15°); partes anterior (flexão) e posterior (extensão). N. axilar (C5–C6)."
                },
                {
                  "q": "Peitoral maior (revisão membro)",
                  "a": "Ver também tórax: aduz o úmero; cabeças clavicular, esternal e abdominal com papéis diferentes na flexão/extensão."
                },
                {
                  "q": "Bíceps braquial",
                  "a": "Supinação do antebraço + flexão fraca do ombro. Cabeça longa: tendão intra-articular; ruptura → «Popeye»."
                },
                {
                  "q": "Tríceps braquial",
                  "a": "Extensão do cotovelo; cabeça longa cruza o ombro. N. radial (C6–C8)."
                }
              ]
            }
          ]
        },
        {
          "title": "Membro superior — antebraço e mão",
          "regiao": "membro_superior",
          "blocks": [
            {
              "type": "sequence",
              "title": "Antebraço — flexores (camada superficial)",
              "steps": [
                {
                  "label": "Pronador redondo",
                  "detail": "pronador fraco"
                },
                {
                  "label": "Flexores radial e ulnar do carpo",
                  "detail": "flexão lateral do punho"
                },
                {
                  "label": "Palmar longo",
                  "detail": "tensão da aponeurose palmar"
                },
                {
                  "label": "Flexores superficial e profundo dos dedos",
                  "detail": "flexão das falanges — túnel do carpo"
                }
              ]
            },
            {
              "type": "cards",
              "items": [
                {
                  "q": "Extensores (ramo radial)",
                  "a": "Extensor radial longo e curto do carpo · Extensor dos dedos · Extensor do dedo mínimo · Extensor ulnar do carpo — todos inervados pelo n. radial (exceto extensor do cotovelo ancone)."
                },
                {
                  "q": "Tênar e hipotenar",
                  "a": "Oponente do polegar · Abdutor curto do polegar · Flexor curto (ramo mediano). Hipotenar: músculos da eminência medial (n. ulnar)."
                },
                {
                  "q": "Espaços e canais",
                  "a": "Túnel do carpo (mediano) · Canal de Guyon (ulnar no punho) · Arco fibroso dos flexores — importante em compressões neuropáticas."
                }
              ]
            }
          ]
        },
        {
          "title": "Membro inferior — quadril e coxa",
          "regiao": "membro_inferior",
          "blocks": [
            {
              "type": "cards",
              "items": [
                {
                  "q": "Glúteo máximo / médio / mínimo",
                  "a": "Máximo: extensão e rotação lateral do quadril (subida de escada). Médio e mínimo: abdução e estabilização da pelve na marcha (Trendelenburg se fracos)."
                },
                {
                  "q": "Quadríceps femoral",
                  "a": "Reto femoral (flexão de quadril + extensão de joelho) · Vastos (extensão de joelho). N. femoral (L2–L4). Reflexo patelar."
                },
                {
                  "q": "Isquiotibiais",
                  "a": "Bíceps femoral · Semitendinoso · Semimembranoso — extensão de quadril + flexão de joelho. N. tibial (ciático)."
                },
                {
                  "q": "Adutores da coxa",
                  "a": "Grande adutor · Longo · Curto · Pectíneo — ramos do obturatório e femoral. Espasmo ou lesão → dor na virilha."
                }
              ]
            }
          ]
        },
        {
          "title": "Membro inferior — perna e pé",
          "regiao": "membro_inferior",
          "blocks": [
            {
              "type": "sequence",
              "title": "Compartimentos da perna (simplificado)",
              "steps": [
                {
                  "label": "Anterior",
                  "detail": "tibial anterior · extensor longo dos dedos — dorsiflexão"
                },
                {
                  "label": "Lateral",
                  "detail": "fibulares longo e curto — eversão"
                },
                {
                  "label": "Superficial posterior",
                  "detail": "gastrocnêmio + sóleo → tendão calcâneo"
                },
                {
                  "label": "Profundo posterior",
                  "detail": "tibial posterior · flexor longo dos dedos — inversão + flexão plantar"
                }
              ]
            },
            {
              "type": "cards",
              "items": [
                {
                  "q": "Tríceps sural",
                  "a": "Gastrocnêmio (2 cabeças sobre duas articulações) + sóleo → tendão de Aquiles → calcâneo. N. tibial. Ruptura: «estalo» + déficit de flexão plantar."
                },
                {
                  "q": "Músculos do pé",
                  "a": "Camadas plantares intrínsecas (interósseos, lumbricais) controlam arco medial e extensão dos dedos no solo."
                },
                {
                  "q": "Síndrome compartimental",
                  "a": "Após trauma ou esforço: dor desproporcional, tensão de compartimento — emergência ortopédica; não confundir com simples cãibra."
                }
              ]
            }
          ]
        },
        {
          "title": "Pelve — assoalho pélvico",
          "regiao": "pelve",
          "blocks": [
            {
              "type": "cards",
              "items": [
                {
                  "q": "Diafragma pélvico",
                  "a": "Levantador do ânus (puborretal, pubococcígeo, iliococcígeo) + isquiococcígeo — suporta vísceras, participa da continência e do parto."
                },
                {
                  "q": "N. pudendo (S2–S4)",
                  "a": "Inerva esfíncter externo e pele perineal; lesão → incontinência e parestesias."
                },
                {
                  "q": "Transverso profundo do períneo",
                  "a": "Estabiliza o centro perineal; trabalha com os bulboesponjosos e isquiocavernosos (ereção e ejaculação em homens; clitóris em mulheres)."
                }
              ]
            }
          ]
        }
      ]
    },
    {
