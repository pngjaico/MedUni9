// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: feedback
// Document ID: auto-generated
// Fields:
//   - tipo:       string (required) - "bug" | "sugestao" | "conteudo" | "interface"
//   - mensagem:   string (required, 1-500 chars) - texto livre do usuário
//   - criadoEm:   string (required) - ISO 8601 date string
//   - disciplina: string (optional, max 20 chars) - sigla da disciplina
//
// Collection: email_access
// Document ID: email em minúsculas (normalizado)
// Fields: ativo, plano, modulosAcesso, maxDispositivos, expira, nota, criadoEm, atualizadoEm
//
// Collection: material_overrides
// Document ID: "{materiaId}__{temaId}" (ex.: tecnica_operatoria__tcar_a3)
// Fields: markdown (string), updatedAt (string ISO), updatedBy (email), materiaId, temaId, basePath (opcional)
// Leitura: utilizadores autenticados. Escrita: isAdmin() apenas.
//
// Collection: users
// Document ID: Firebase Auth UID
// Fields:
//   - email:     string
//   - plano:     string
//   - semestre:  number (1-6)
//   - codeHash:  string (first 8 chars of hashed access code)
//   - deviceId:  string
//   - criadoEm:  string (ISO 8601)
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Bloqueia tudo por padrão
    match /{document=**} {
      allow read, write: if false;
    }

    // Stripe: extensão firestore-stripe-payments (POSTINSTALL — leitura de produtos; cliente só o próprio UID)
    match /customers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      match /checkout_sessions/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /subscriptions/{id} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }
      match /payments/{id} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /products/{productId} {
      allow read: if request.auth != null;
      match /prices/{priceId} {
        allow read: if request.auth != null;
      }
      match /tax_rates/{taxRateId} {
        allow read: if request.auth != null;
      }
    }

    // Users: each user can only read/write their own profile
    match /users/{userId} {
      allow read:   if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow create: if isAdmin() || (
        request.auth != null &&
        request.auth.uid == userId &&
        isSafeSelfUserCreate()
      );
      allow update: if isAdmin() || (
        request.auth != null &&
        request.auth.uid == userId &&
        (isSafeSelfUserUpdate() || isSafeSelfProfileCompletion())
      );
      allow delete: if false;
    }

    // User session telemetry (device + network signal, alert-only mode)
    // Escrita normal deve passar por Cloud Function/Admin SDK para evitar fraude de evidencias.
    match /users/{userId}/sessions/{sessionId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Cronograma de estudos do usuario. O app escreve apenas dentro do proprio UID.
    match /users/{userId}/study_schedule/{scheduleId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow create, update: if (
        (request.auth != null && request.auth.uid == userId) || isAdmin()
      ) && isValidStudySchedule();
      allow delete: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // Progresso do aluno: cache multi-dispositivo para flashcards, questoes, erros e sessoes.
    // O cliente escreve apenas IDs/estado de estudo dentro do proprio UID; conteudo fica estatico em Hosting.
    match /users/{userId}/flashcard_progress/{cardId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if (isOwner(userId) || isAdmin()) && isValidFlashcardProgress();
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/quiz_progress/{questionId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if (isOwner(userId) || isAdmin()) && isValidQuizProgress();
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/quiz_errors/{questionId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if (isOwner(userId) || isAdmin()) && isValidQuizError();
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/quiz_sessions/{sessionId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if (isOwner(userId) || isAdmin()) && isValidQuizSession();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Security events feed used by admin security panel
    match /security_events/{eventId} {
      allow create: if isAdmin();
      allow read: if isAdmin() || (
        request.auth != null &&
        resource.data.uid == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    match /profile_change_requests/{requestId} {
      allow create: if request.auth != null &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.status == 'pending';
      allow read: if isAdmin() ||
                  (request.auth != null && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /feedback/{docId} {
      allow read, update, delete: if false;
      allow create: if isValidFeedback();
    }

    // Convites por email (liberação de acesso sem chave estática)
    // Document ID = email em minúsculas (normalizado no app/admin)
    match /email_access/{emailDocId} {
      allow read: if isAdmin() || (
        request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == emailDocId
      );
      allow create, update, delete: if isAdmin();
    }

    // Vendas Stripe com cupom de embaixador (escrita só via Cloud Function / Admin SDK)
    match /stripe_ambassador_sales/{saleId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /account_enforcement/{userId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
      match /events/{eventId} {
        allow read: if isAdmin();
        allow create, update, delete: if isAdmin();
      }
    }

    // Sobreposição de materiais .md (Hosting estático + Firestore para admin)
    match /material_overrides/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Renderizacoes rastreaveis de Resumo A4.
    // Escrita ocorre apenas via Cloud Function/Admin SDK; cliente pode ler o proprio rastro.
    match /summary_renders/{traceId} {
      allow read: if isAdmin() || (
        request.auth != null &&
        resource.data.uid == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    // Templates confirmados de cronograma por turma. Escrita normal ocorre via Cloud Function/Admin SDK.
    match /schedule_templates/{templateId} {
      allow read: if isAdmin() || (request.auth != null && canReadScheduleTemplate());
      allow create, update, delete: if isAdmin();
    }
  }

  function isAdmin() {
    return request.auth != null &&
           request.auth.token.email_verified == true &&
           request.auth.token.email is string &&
           request.auth.token.email.lower() == 'pngjaico@gmail.com';
  }

  function isOwner(userId) {
    return request.auth != null && request.auth.uid == userId;
  }

  // ===============================================================
  // Helper Functions
  // ===============================================================

  function isValidUserProfile() {
    let d = request.resource.data;
    return d.keys().hasAll(['email', 'plano', 'semestre', 'criadoEm']) &&
           d.keys().hasOnly(['email', 'plano', 'semestre', 'codeHash', 'deviceId', 'criadoEm', 'loginDate', 'modulo']) &&
           d.email is string && d.email.size() <= 200 &&
           d.plano is string && d.plano in ['basico', 'completo', 'vitalicio', 'premium', 'trial'] &&
           d.semestre is number && d.semestre >= 1 && d.semestre <= 6 &&
           d.criadoEm is string;
  }

  function isValidUserProfileUpdate() {
    let d = request.resource.data;
    return d.keys().hasOnly(['email', 'plano', 'semestre', 'codeHash', 'deviceId', 'criadoEm', 'loginDate', 'modulo']) &&
           d.email is string &&
           d.plano is string &&
           d.semestre is number && d.semestre >= 1 && d.semestre <= 6;
  }

  // D0 hardening: cliente autenticado nao pode auto-elevar plano/modulosAcesso.
  function isSafeSelfUserCreate() {
    let d = request.resource.data;
    return d.keys().hasOnly(selfCreateUserKeys()) &&
           d.email is string &&
           d.plano is string && d.plano in ['basico', 'gratuito', 'trial'] &&
           d.semestre is number && d.semestre >= 1 && d.semestre <= 6 &&
           (!('accountStatus' in d) || d.accountStatus == 'active') &&
           (
             (
               d.plano in ['gratuito', 'trial'] &&
               (!('modulosAcesso' in d) || d.modulosAcesso == null)
             ) ||
             (d.modulosAcesso is list && d.modulosAcesso.size() == 1 && d.modulosAcesso[0] == 1)
           ) &&
           (
             !('maxDispositivos' in d) ||
             (d.maxDispositivos is number && d.maxDispositivos <= 2)
           );
  }

  function isSafeSelfUserUpdate() {
    let changed = request.resource.data.diff(resource.data).affectedKeys();
    return resource != null &&
           changed.hasOnly(selfMutableUserKeys()) &&
           isSafeTelemetryFields();
  }

  function isSafeSelfProfileCompletion() {
    return resource != null &&
           !('plano' in resource.data) &&
           request.resource.data.keys().hasOnly(selfCreateUserKeys()) &&
           request.resource.data.termsVersionAccepted == resource.data.termsVersionAccepted &&
           request.resource.data.termsAcceptedAt == resource.data.termsAcceptedAt &&
           request.resource.data.privacyAcceptedAt == resource.data.privacyAcceptedAt &&
           isSafeSelfUserCreate();
  }

  function selfCreateUserKeys() {
    return [
      'email',
      'plano',
      'semestre',
      'modulo',
      'faculdadeId',
      'faculdadeNome',
      'campusId',
      'campusNome',
      'codeHash',
      'modulosAcesso',
      'deviceId',
      'deviceIds',
      'sessionToken',
      'maxDispositivos',
      'accessSource',
      'emailGrantId',
      'criadoEm',
      'loginDate',
      'lastSeenAt',
      'lastSeenUa',
      'termsVersionAccepted',
      'termsAcceptedAt',
      'privacyAcceptedAt',
      'termsEvidence',
      'accountStatus',
      'updatedAt'
    ];
  }

  function selfMutableUserKeys() {
    return [
      'deviceId',
      'deviceIds',
      'sessionToken',
      'loginDate',
      'lastSeenAt',
      'lastSeenUa',
      'updatedAt'
    ];
  }

  function isSafeTelemetryFields() {
    let d = request.resource.data;
    return (!('deviceId' in d) || d.deviceId is string) &&
           (!('deviceIds' in d) || (d.deviceIds is list && d.deviceIds.size() <= 5)) &&
           (!('sessionToken' in d) || d.sessionToken is string) &&
           (!('loginDate' in d) || d.loginDate is string) &&
           (!('lastSeenAt' in d) || d.lastSeenAt is string) &&
           (!('lastSeenUa' in d) || (d.lastSeenUa is string && d.lastSeenUa.size() <= 200));
  }

  function isValidStudySchedule() {
    let d = request.resource.data;
    return d.keys().hasOnly([
             'timezone',
             'module',
             'room',
             'dailyTarget',
             'examDates',
             'p1LessonsByMateria',
             'p2LessonsByMateria',
             'manualItems',
             'completedItems',
             'source',
             'generatedAt',
             'updatedAt'
           ]) &&
           d.timezone is string &&
           d.timezone.size() <= 40 &&
           d.module is number &&
           d.module >= 1 &&
           d.module <= 12 &&
           d.room is string &&
           d.room.size() <= 2 &&
           d.dailyTarget is number &&
           d.dailyTarget >= 1 &&
           d.dailyTarget <= 12 &&
           d.examDates is map &&
           d.p1LessonsByMateria is map &&
           d.p2LessonsByMateria is map &&
           d.manualItems is list &&
           d.manualItems.size() <= 120 &&
           d.completedItems is list &&
           d.completedItems.size() <= 1000 &&
           d.source is string &&
           d.source in ['manual', 'ai_draft', 'template'] &&
           d.updatedAt is string;
  }

  function isValidFlashcardProgress() {
    let d = request.resource.data;
    return d.keys().hasOnly([
             'cardId',
             'materiaId',
             'aulaId',
             'reps',
             'ef',
             'interval',
             'due',
             'lastReviewedAt',
             'buried',
             'updatedAt'
           ]) &&
           d.cardId is string &&
           d.cardId.size() <= 160 &&
           d.materiaId is string &&
           d.materiaId.size() <= 80 &&
           d.aulaId is string &&
           d.aulaId.size() <= 120 &&
           d.reps is number &&
           d.reps >= 0 &&
           d.reps <= 5000 &&
           d.ef is number &&
           d.ef >= 1 &&
           d.ef <= 5 &&
           d.interval is number &&
           d.interval >= 0 &&
           d.interval <= 36500 &&
           d.due is number &&
           d.lastReviewedAt is number &&
           d.buried is bool &&
           d.updatedAt is number;
  }

  function isValidQuizProgress() {
    let d = request.resource.data;
    return d.keys().hasOnly([
             'questionId',
             'materiaId',
             'aulaId',
             'attempts',
             'correctAttempts',
             'wrongAttempts',
             'done',
             'level',
             'nextReview',
             'lastResult',
             'lastAnsweredAt',
             'updatedAt'
           ]) &&
           d.questionId is string &&
           d.questionId.size() <= 160 &&
           d.materiaId is string &&
           d.materiaId.size() <= 80 &&
           d.aulaId is string &&
           d.aulaId.size() <= 120 &&
           d.attempts is number &&
           d.attempts >= 0 &&
           d.attempts <= 5000 &&
           d.correctAttempts is number &&
           d.correctAttempts >= 0 &&
           d.correctAttempts <= d.attempts &&
           d.wrongAttempts is number &&
           d.wrongAttempts >= 0 &&
           d.wrongAttempts <= d.attempts &&
           d.done is bool &&
           d.level is number &&
           d.level >= 0 &&
           d.level <= 5 &&
           (d.nextReview == null || d.nextReview is number) &&
           d.lastResult is string &&
           d.lastResult in ['', 'correct', 'wrong'] &&
           d.lastAnsweredAt is number &&
           d.updatedAt is number;
  }

  function isValidQuizError() {
    let d = request.resource.data;
    return d.keys().hasOnly([
             'questionId',
             'materiaId',
             'aulaId',
             'active',
             'wrongCount',
             'addedAt',
             'updatedAt'
           ]) &&
           d.questionId is string &&
           d.questionId.size() <= 160 &&
           d.materiaId is string &&
           d.materiaId.size() <= 80 &&
           d.aulaId is string &&
           d.aulaId.size() <= 120 &&
           d.active is bool &&
           d.wrongCount is number &&
           d.wrongCount >= 0 &&
           d.wrongCount <= 5000 &&
           d.addedAt is number &&
           d.updatedAt is number;
  }

  function isValidQuizSession() {
    let d = request.resource.data;
    return d.keys().hasOnly([
             'sessionId',
             'materiaId',
             'aulaIds',
             'score',
             'total',
             'accuracy',
             'completedAt',
             'durationMs',
             'mode',
             'date',
             'time',
             'updatedAt'
           ]) &&
           d.sessionId is string &&
           d.sessionId.size() <= 180 &&
           d.materiaId is string &&
           d.materiaId.size() <= 80 &&
           d.aulaIds is list &&
           d.aulaIds.size() <= 80 &&
           d.score is number &&
           d.score >= 0 &&
           d.total is number &&
           d.total >= 0 &&
           d.total <= 500 &&
           d.score <= d.total &&
           d.accuracy is number &&
           d.accuracy >= 0 &&
           d.accuracy <= 100 &&
           d.completedAt is number &&
           d.durationMs is number &&
           d.durationMs >= 0 &&
           d.mode is string &&
           d.mode.size() <= 40 &&
           d.date is string &&
           d.date.size() <= 40 &&
           d.time is string &&
           d.time.size() <= 40 &&
           d.updatedAt is number;
  }

  function canReadScheduleTemplate() {
    let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
    return userDoc.data.faculdadeId == resource.data.facultyId &&
           userDoc.data.campusId == resource.data.campusId &&
           (
             userDoc.data.modulo == resource.data.module ||
             userDoc.data.semestre == resource.data.module ||
             (userDoc.data.modulosAcesso is list && resource.data.module in userDoc.data.modulosAcesso)
           );
  }

  function isValidTipo() {
    return request.resource.data.tipo is string &&
           request.resource.data.tipo in ['bug', 'sugestao', 'conteudo', 'interface'];
  }

  function isValidMensagem() {
    return request.resource.data.mensagem is string &&
           request.resource.data.mensagem.size() >= 1 &&
           request.resource.data.mensagem.size() <= 500;
  }

  function isValidCriadoEm() {
    return request.resource.data.criadoEm is string &&
           request.resource.data.criadoEm.size() >= 10;
  }

  function hasOnlyAllowedFields() {
    return request.resource.data.keys().hasAll(['tipo', 'mensagem', 'criadoEm']) &&
           request.resource.data.keys().hasOnly(['tipo', 'mensagem', 'criadoEm', 'disciplina']);
  }

  function isValidDisciplina() {
    return !('disciplina' in request.resource.data) ||
           (request.resource.data.disciplina is string &&
            request.resource.data.disciplina.size() <= 20);
  }

  function isValidFeedback() {
    return hasOnlyAllowedFields() &&
           isValidTipo() &&
           isValidMensagem() &&
           isValidCriadoEm() &&
           isValidDisciplina();
  }
}
