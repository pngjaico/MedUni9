// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: feedback
// Document ID: auto-generated
// Fields:
//   - tipo:       string (required) - "bug" | "sugestao" | "conteudo" | "interface"
//   - mensagem:   string (required, 1-500 chars) - texto livre do usuário
//   - criadoEm:   string (required) - ISO 8601 date string
//   - disciplina: string (optional, max 20 chars) - sigla da disciplina
//
// Collection: email_access
// Document ID: email em minúsculas (normalizado)
// Fields: ativo, plano, modulosAcesso, maxDispositivos, expira, nota, criadoEm, atualizadoEm
//
// Collection: material_overrides
// Document ID: "{materiaId}__{temaId}" (ex.: tecnica_operatoria__tcar_a3)
// Fields: markdown (string), updatedAt (string ISO), updatedBy (email), materiaId, temaId, basePath (opcional)
// Leitura: utilizadores autenticados. Escrita: isAdmin() apenas.
//
// Collection: users
// Document ID: Firebase Auth UID
// Fields:
//   - email:     string
//   - plano:     string
//   - semestre:  number (1-6)
//   - codeHash:  string (first 8 chars of hashed access code)
//   - deviceId:  string
//   - criadoEm:  string (ISO 8601)
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Bloqueia tudo por padrão
    match /{document=**} {
      allow read, write: if false;
    }

    // Stripe: extensão firestore-stripe-payments (POSTINSTALL — leitura de produtos; cliente só o próprio UID)
    match /customers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      match /checkout_sessions/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /subscriptions/{id} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }
      match /payments/{id} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /products/{productId} {
      allow read: if true;
      match /prices/{priceId} {
        allow read: if true;
      }
      match /tax_rates/{taxRateId} {
        allow read: if true;
      }
    }

    // Users: each user can only read/write their own profile
    match /users/{userId} {
      allow read:   if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow create: if isAdmin() || (
        request.auth != null &&
        request.auth.uid == userId &&
        isSafeSelfUserCreate()
      );
      allow update: if isAdmin() || (
        request.auth != null &&
        request.auth.uid == userId &&
        isSafeSelfUserUpdate()
      );
      allow delete: if false;
    }

    // User session telemetry (device + network signal, alert-only mode)
    match /users/{userId}/sessions/{sessionId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow create, update: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow delete: if false;
    }

    // Security events feed used by admin security panel
    match /security_events/{eventId} {
      allow create: if isAdmin() || (
        request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasAll(['uid', 'type', 'riskLevel', 'createdAt'])
      );
      allow read: if isAdmin() || (
        request.auth != null &&
        resource.data.uid == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    match /profile_change_requests/{requestId} {
      allow create: if request.auth != null &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.status == 'pending';
      allow read: if isAdmin() ||
                  (request.auth != null && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /feedback/{docId} {
      allow read, update, delete: if false;
      allow create: if isValidFeedback();
    }

    // Convites por email (liberação de acesso sem chave estática)
    // Document ID = email em minúsculas (normalizado no app/admin)
    match /email_access/{emailDocId} {
      allow read: if isAdmin() || (
        request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == emailDocId
      );
      allow create, update, delete: if isAdmin();
    }

    // Vendas Stripe com cupom de embaixador (escrita só via Cloud Function / Admin SDK)
    match /stripe_ambassador_sales/{saleId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Sobreposição de materiais .md (Hosting estático + Firestore para admin)
    match /material_overrides/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }
  }

  function isAdmin() {
    return request.auth != null &&
           request.auth.token.email_verified == true &&
           request.auth.token.email is string &&
           request.auth.token.email.lower() == 'pngjaico@gmail.com';
  }

  // ===============================================================
  // Helper Functions
  // ===============================================================

  function isValidUserProfile() {
    let d = request.resource.data;
    return d.keys().hasAll(['email', 'plano', 'semestre', 'criadoEm']) &&
           d.keys().hasOnly(['email', 'plano', 'semestre', 'codeHash', 'deviceId', 'criadoEm', 'loginDate', 'modulo']) &&
           d.email is string && d.email.size() <= 200 &&
           d.plano is string && d.plano in ['basico', 'completo', 'vitalicio', 'premium', 'trial'] &&
           d.semestre is number && d.semestre >= 1 && d.semestre <= 6 &&
           d.criadoEm is string;
  }

  function isValidUserProfileUpdate() {
    let d = request.resource.data;
    return d.keys().hasOnly(['email', 'plano', 'semestre', 'codeHash', 'deviceId', 'criadoEm', 'loginDate', 'modulo']) &&
           d.email is string &&
           d.plano is string &&
           d.semestre is number && d.semestre >= 1 && d.semestre <= 6;
  }

  // D0 hardening: cliente autenticado nao pode auto-elevar plano/modulosAcesso.
  function isSafeSelfUserCreate() {
    let d = request.resource.data;
    return d.email is string &&
           d.plano is string && d.plano in ['basico', 'gratuito', 'trial'] &&
           d.semestre is number && d.semestre >= 1 && d.semestre <= 6 &&
           (
             !('modulosAcesso' in d) ||
             d.modulosAcesso == null ||
             (d.modulosAcesso is list && d.modulosAcesso.size() <= 1 && d.modulosAcesso[0] == 1)
           ) &&
           (
             !('maxDispositivos' in d) ||
             (d.maxDispositivos is number && d.maxDispositivos <= 2)
           );
  }

  function isSafeSelfUserUpdate() {
    return resource != null &&
           request.resource.data.plano == resource.data.plano &&
           request.resource.data.modulosAcesso == resource.data.modulosAcesso &&
           request.resource.data.maxDispositivos == resource.data.maxDispositivos &&
           request.resource.data.accessSource == resource.data.accessSource &&
           request.resource.data.emailGrantId == resource.data.emailGrantId &&
           request.resource.data.semestre == resource.data.semestre &&
           request.resource.data.modulo == resource.data.modulo;
  }

  function isValidTipo() {
    return request.resource.data.tipo is string &&
           request.resource.data.tipo in ['bug', 'sugestao', 'conteudo', 'interface'];
  }

  function isValidMensagem() {
    return request.resource.data.mensagem is string &&
           request.resource.data.mensagem.size() >= 1 &&
           request.resource.data.mensagem.size() <= 500;
  }

  function isValidCriadoEm() {
    return request.resource.data.criadoEm is string &&
           request.resource.data.criadoEm.size() >= 10;
  }

  function hasOnlyAllowedFields() {
    return request.resource.data.keys().hasAll(['tipo', 'mensagem', 'criadoEm']) &&
           request.resource.data.keys().hasOnly(['tipo', 'mensagem', 'criadoEm', 'disciplina']);
  }

  function isValidDisciplina() {
    return !('disciplina' in request.resource.data) ||
           (request.resource.data.disciplina is string &&
            request.resource.data.disciplina.size() <= 20);
  }

  function isValidFeedback() {
    return hasOnlyAllowedFields() &&
           isValidTipo() &&
           isValidMensagem() &&
           isValidCriadoEm() &&
           isValidDisciplina();
  }
}
